{
  "name": "yamusic-sdk-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "codegen": "pnpm --filter @dvkskustikom/codegen generate",
