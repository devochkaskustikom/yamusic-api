{
  "name": "@dvkskustikom/yamusic-api",
  "version": "0.1.0",
  "description": "Unofficial TypeScript SDK for the Yandex Music API",
  "keywords": [
    "yandex-music",
    "api",
    "sdk",
    "client",
    "typescript",
    "music"
  ],
  "author": "dvkskustikom",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devochkaskustikom/yamusic-api.git",
    "directory": "packages/yamusic-api"
  },
  "homepage": "https://github.com/devochkaskustikom/yamusic-api#readme",
  "bugs": {
    "url": "https://github.com/devochkaskustikom/yamusic-api/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build && pnpm test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
